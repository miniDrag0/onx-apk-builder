#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path('..', __dir__)
$LOAD_PATH.unshift(File.join(root, 'lib'))

# Bundler may abort/exit on Windows when optional gems are missing.
# Keep build runnable with system gems (e.g. `gem install nokogiri`).
begin
  require 'bundler/setup'
rescue Exception => e
  raise if e.is_a?(Interrupt) || e.is_a?(SignalException) || e.is_a?(NoMemoryError)

  warn("[onx-apk-builder] bundler/setup skipped: #{e.message}")
end

require 'onx_apk_builder'

exit OnxApkBuilder::CLI.start(ARGV)
