#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path('..', __dir__)
$LOAD_PATH.unshift(File.join(root, 'lib'))

require 'bundler/setup' if File.exist?(File.join(root, 'Gemfile.lock')) || File.exist?(File.join(root, 'Gemfile'))
require 'onx_apk_builder'

exit OnxApkBuilder::CLI.start(ARGV)
